# Production required variables
DATABASE_URL="postgresql://user:pass@host:5432/hanabi"
JWT_SECRET="change-me-in-production"
FRONTEND_ORIGINS="https://your-vercel-domain.vercel.app"

# Local development overrides
PORT=4000
NODE_ENV=development

# =============================================================================
# FRONTEND (Vite) LOCAL DEV — DO NOT SET VITE_API_BASE_URL HERE OR IN
# frontend/.env DURING LOCAL DEVELOPMENT. SEE frontend/.env.example.
#
# When VITE_API_BASE_URL is empty/undefined, Vite automatically proxies /api/*
# to http://127.0.0.1:4000 via vite.config.ts — this is the correct local setup
# and also ensures cookies (auth tokens) are sent correctly (same origin).
#
# Setting VITE_API_BASE_URL to a remote host (Render, Vercel, etc.) locally
# forces every call to go over the public internet → 10-60s Render cold starts
# → apparent "black screen hangs" during every page navigation.
#
# If you need a backend other than :4000 locally, EDIT vite.config.ts proxy
# target, not this variable.
# =============================================================================
# PRODUCTION (Vercel deploy) ONLY. Set inside Vercel dashboard env vars:
# VITE_API_BASE_URL="https://your-backend-app.onrender.com/api"

